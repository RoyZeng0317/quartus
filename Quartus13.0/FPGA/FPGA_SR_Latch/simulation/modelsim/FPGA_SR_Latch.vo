`timescale 1 ps/ 1 ps

module FPGA_SR_Latch (
	Q,
	R,
	Q0,
	S);
output 	Q;
input 	R;
output 	Q0;
input 	S;

// Design Ports Information
// Q	=>  Location: PIN_F11,	 I/O Standard: 2.5 V,	 Current Strength: Default
// Q0	=>  Location: PIN_D13,	 I/O Standard: 2.5 V,	 Current Strength: Default
// R	=>  Location: PIN_G10,	 I/O Standard: 2.5 V,	 Current Strength: Default
// S	=>  Location: PIN_C12,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \Q~output_o ;
wire \Q0~output_o ;
wire \R~input_o ;
wire \inst~combout ;
wire \S~input_o ;
wire \inst1~combout ;


// Location: IOOBUF_X33_Y24_N9
cycloneiv_io_obuf \Q~output (
	.i(!\inst~combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Q~output_o ),
	.obar());
// synopsys translate_off
defparam \Q~output .bus_hold = "false";
defparam \Q~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOOBUF_X29_Y31_N9
cycloneiv_io_obuf \Q0~output (
	.i(!\inst1~combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Q0~output_o ),
	.obar());
// synopsys translate_off
defparam \Q0~output .bus_hold = "false";
defparam \Q0~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOIBUF_X33_Y22_N8
cycloneiv_io_ibuf \R~input (
	.i(R),
	.ibar(gnd),
	.o(\R~input_o ));
// synopsys translate_off
defparam \R~input .bus_hold = "false";
defparam \R~input .simulate_z_as = "z";
// synopsys translate_on

// Location: LCCOMB_X32_Y24_N16
cycloneiv_lcell_comb inst(
// Equation(s):
// \inst~combout  = (\R~input_o ) # (!\inst~combout )

	.dataa(gnd),
	.datab(\inst~combout ),
	.datac(\R~input_o ),
	.datad(gnd),
	.cin(gnd),
	.combout(\inst~combout ),
	.cout());
// synopsys translate_off
defparam inst.lut_mask = 16'hF3F3;
defparam inst.sum_lutc_input = "datac";
// synopsys translate_on

// Location: IOIBUF_X31_Y31_N8
cycloneiv_io_ibuf \S~input (
	.i(S),
	.ibar(gnd),
	.o(\S~input_o ));
// synopsys translate_off
defparam \S~input .bus_hold = "false";
defparam \S~input .simulate_z_as = "z";
// synopsys translate_on

// Location: LCCOMB_X31_Y30_N0
cycloneiv_lcell_comb inst1(
// Equation(s):
// \inst1~combout  = (\S~input_o ) # (!\inst1~combout )

	.dataa(gnd),
	.datab(\inst1~combout ),
	.datac(gnd),
	.datad(\S~input_o ),
	.cin(gnd),
	.combout(\inst1~combout ),
	.cout());
// synopsys translate_off
defparam inst1.lut_mask = 16'hFF33;
defparam inst1.sum_lutc_input = "datac";
// synopsys translate_on

assign Q = \Q~output_o ;

assign Q0 = \Q0~output_o ;

endmodule
