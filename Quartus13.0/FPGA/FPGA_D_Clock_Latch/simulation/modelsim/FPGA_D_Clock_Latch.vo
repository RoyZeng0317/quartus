`timescale 1 ps/ 1 ps

module FPGA_D_Clock_Latch (
	Q0,
	D,
	CK,
	Q);
output 	Q0;
input 	D;
input 	CK;
output 	Q;

// Design Ports Information
// Q0	=>  Location: PIN_L7,	 I/O Standard: 2.5 V,	 Current Strength: Default
// Q	=>  Location: PIN_A7,	 I/O Standard: 2.5 V,	 Current Strength: Default
// D	=>  Location: PIN_N10,	 I/O Standard: 2.5 V,	 Current Strength: Default
// CK	=>  Location: PIN_L5,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \Q0~output_o ;
wire \Q~output_o ;
wire \D~input_o ;
wire \CK~input_o ;
wire \inst4~1_combout ;
wire \inst3~combout ;


// Location: IOOBUF_X14_Y0_N2
cycloneiv_io_obuf \Q0~output (
	.i(!\inst4~1_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Q0~output_o ),
	.obar());
// synopsys translate_off
defparam \Q0~output .bus_hold = "false";
defparam \Q0~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOOBUF_X12_Y31_N2
cycloneiv_io_obuf \Q~output (
	.i(\inst3~combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\Q~output_o ),
	.obar());
// synopsys translate_off
defparam \Q~output .bus_hold = "false";
defparam \Q~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOIBUF_X26_Y0_N8
cycloneiv_io_ibuf \D~input (
	.i(D),
	.ibar(gnd),
	.o(\D~input_o ));
// synopsys translate_off
defparam \D~input .bus_hold = "false";
defparam \D~input .simulate_z_as = "z";
// synopsys translate_on

// Location: IOIBUF_X14_Y0_N8
cycloneiv_io_ibuf \CK~input (
	.i(CK),
	.ibar(gnd),
	.o(\CK~input_o ));
// synopsys translate_off
defparam \CK~input .bus_hold = "false";
defparam \CK~input .simulate_z_as = "z";
// synopsys translate_on

// Location: LCCOMB_X16_Y1_N26
cycloneiv_lcell_comb \inst4~1 (
// Equation(s):
// \inst4~1_combout  = (\CK~input_o  & (\D~input_o )) # (!\CK~input_o  & ((\inst4~1_combout )))

	.dataa(gnd),
	.datab(\D~input_o ),
	.datac(\inst4~1_combout ),
	.datad(\CK~input_o ),
	.cin(gnd),
	.combout(\inst4~1_combout ),
	.cout());
// synopsys translate_off
defparam \inst4~1 .lut_mask = 16'hCCF0;
defparam \inst4~1 .sum_lutc_input = "datac";
// synopsys translate_on

// Location: LCCOMB_X16_Y1_N0
cycloneiv_lcell_comb inst3(
// Equation(s):
// \inst3~combout  = (\inst4~1_combout ) # ((\CK~input_o  & \D~input_o ))

	.dataa(\inst4~1_combout ),
	.datab(gnd),
	.datac(\CK~input_o ),
	.datad(\D~input_o ),
	.cin(gnd),
	.combout(\inst3~combout ),
	.cout());
// synopsys translate_off
defparam inst3.lut_mask = 16'hFAAA;
defparam inst3.sum_lutc_input = "datac";
// synopsys translate_on

assign Q0 = \Q0~output_o ;

assign Q = \Q~output_o ;

endmodule
